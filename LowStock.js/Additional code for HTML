/*
  low-stock.js - Avila
 
  Shows a red "Low Stock Alert" card for items that are low or out of stock.
  Clicking "View Items →" opens the page that shows only the low stock items.
 
  How to add it on the page:
  1. In your HTML, add this above your own <script> tag so it loads first:
     <script src="js/low-stock.js"></script>
  2. In your JS, after your items are loaded, call:
     LowStockAlert.render(items, 'low-stock-box');
     Call it again after you add, edit or delete an item.
  3. (Optional) To choose where the alert appears, put this in your HTML.
     If you skip it, the alert shows at the top of the page:
     <div id="low-stock-box"></div>
  4. (Optional) The "View Items" button goes to my_items.php?low_stock=1
     by default. To use a different page, call this before render():
     LowStockAlert.setViewItemsLink('my_items.php?low_stock=1');
     That page must show only the low stock items when it opens
     (if it uses JavaScript, LowStockAlert.getLowItems(items) gives
     you just the low and out of stock items).
 
  Each item needs name, quantity and restock_level.
  Example: { name: 'Ballpen', quantity: 3, restock_level: 5 }
 
  Low means quantity is at or below restock_level.
  Out of stock means quantity is 0.
  The card hides itself when nothing is low.
*/
 

======================================================================================
js


const LOW_STOCK_FIELDS = {
    name: 'name',
    quantity: 'quantity',
    restockLevel: 'restock_level'
};

const LowStockAlert = (function () {

    // Where the "View Items" button goes (the page that shows only low stock items)
    let viewItemsLink = 'my_items.php?low_stock=1';

    function getStatus(item) {
        const qty = Number(item[LOW_STOCK_FIELDS.quantity]);
        const level = Number(item[LOW_STOCK_FIELDS.restockLevel]);
        if (!Number.isFinite(qty) || !Number.isFinite(level)) return 'ok';
        if (qty === 0) return 'out';
        if (qty <= level) return 'low';
        return 'ok';
    }

    function getLowItems(items) {
        return items
            .filter(function (item) { return getStatus(item) !== 'ok'; })
            .sort(function (a, b) {
                return Number(a[LOW_STOCK_FIELDS.quantity]) - Number(b[LOW_STOCK_FIELDS.quantity]);
            });
    }

    function findBox(container) {
        if (typeof container !== 'string') return container;
        let box = document.getElementById(container);
        if (!box) {
            box = document.createElement('div');
            box.id = container;
            const anchor = document.querySelector('main') || document.body;
            anchor.insertBefore(box, anchor.firstChild);
        }
        return box;
    }

    function render(items, container) {
        const box = findBox(container);
        if (!box) return;

        const low = getLowItems(items);
        box.innerHTML = '';
        box.classList.add('low-stock-alert');
        box.hidden = low.length === 0;
        if (low.length === 0) {
            box.style.cssText = 'display:none;';
            return;
        }

        // Red alert card, like the dashboard
        box.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:16px;' +
            'background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.4);color:#f87171;' +
            'border-radius:12px;padding:14px 18px;font-family:system-ui,sans-serif;';

        const text = document.createElement('div');

        const title = document.createElement('strong');
        title.textContent = '⚠️ Low Stock Alert';
        text.appendChild(title);

        const message = document.createElement('div');
        message.textContent = low.length + (low.length === 1 ? ' item is' : ' items are') + ' running low!';
        message.style.cssText = 'font-size:13px;margin-top:4px;';
        text.appendChild(message);

        const button = document.createElement('a');
        button.textContent = 'View Items →';
        button.href = viewItemsLink;
        button.style.cssText = 'border:1px solid #f87171;color:#f87171;border-radius:8px;' +
            'padding:8px 14px;font-size:13px;text-decoration:none;white-space:nowrap;';

        box.appendChild(text);
        box.appendChild(button);
    }

    function setViewItemsLink(link) {
        viewItemsLink = link;
    }

    return { getStatus: getStatus, getLowItems: getLowItems, render: render, setViewItemsLink: setViewItemsLink };
})();
